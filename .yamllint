# Body of Evidence — YAML lint policy
#
# Deliberately scoped: rules here protect data integrity and diff hygiene.
# Purely stylistic rules are disabled so the gate stays meaningfully green —
# a permanently red quality gate is worse than no gate.

extends: default

# fixtures/invalid/broken-unmanifested-symlink/claim-broken-symlink.yaml is
# a real tracked symlink whose target does NOT exist on purpose — it proves
# the validators reject a dangling unmanifested symlink instead of crashing
# (D-020/H-19). yamllint itself crashes (not just errors) trying to open a
# dangling symlink, so it must be excluded from the lint pass; the
# validators, not yamllint, are what's supposed to examine this file.
ignore: |
  fixtures/invalid/broken-unmanifested-symlink/claim-broken-symlink.yaml

rules:
  # Integrity-relevant: keep as errors
  key-duplicates: enable
  trailing-spaces: enable
  new-line-at-end-of-file: enable

  # Long prose fields and URLs make hard line caps impractical
  line-length:
    max: 120
    level: warning

  # Entity files are single-document by design; requiring '---' adds noise
  document-start: disable

  # Comment alignment in annotated examples is intentional
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable

  # Quoting style in examples is deliberate (quoted IDs, unquoted scalars)
  quoted-strings: disable

  truthy:
    allowed-values: ["true", "false"]
